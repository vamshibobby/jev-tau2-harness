# Copy to .env and fill in. .env is gitignored. Only needed for new runs; reproduce_tables.py needs none of these.

# Jev, the decision model (served through OpenRouter's decisions API). Also used for agent models given as
# openrouter/<id> (the smaller open models of Table 5).
OPENROUTER_API_KEY=

# Agent models on Vertex AI (Gemini 3.8 Flash, Gemini 3.5 Flash-Lite, Gemma 4 26B A4B) and Gemini 2.5 Flash, the
# simulated customer: a service-account key file with the Vertex AI User role, and your Google Cloud project.
GOOGLE_APPLICATION_CREDENTIALS=
VERTEX_PROJECT=
# VERTEX_LOCATION=global          # Gemini 3.8 Flash is served from the global endpoint

# ...or the Gemini API instead of Vertex AI (leave GOOGLE_APPLICATION_CREDENTIALS unset), and run with
# --user-llm gemini/gemini-2.5-flash
# GEMINI_API_KEY=

# tau2's airline data (see README, "Setup")
# TAU2_DATA_DIR=

# Optional
# THINKING=low                    # Gemini thinking level for the agent
# GEMINI_SPEND_STOP=40            # stop a run once the agent's estimated model spend passes this many dollars
